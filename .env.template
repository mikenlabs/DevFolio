# Brevo (formerly Sendinblue) API Configuration
# ================================================
# For PHP hosting:  cp .env.template .env
# For Vercel local: cp .env.template .env.local
# Get your Brevo API key at: https://app.brevo.com/settings/apis

# --- Transactional Email API ---
BREVO_API_KEY=your_brevo_api_key_here

# Sender email (must be verified in your Brevo account)
BREVO_FROM_EMAIL=uchemichaelbartholomew@gmail.com

# Recipient email (where messages from the contact form are sent)
BREVO_TO_EMAIL=uchemichaelbartholomew@gmail.com

# --- Optional: SMTP Configuration (alternative) ---
# BREVO_SMTP_HOST=smtp.brevo.com
# BREVO_SMTP_PORT=587
# BREVO_SMTP_USER=your_smtp_user
# BREVO_SMTP_PASS=your_smtp_pass

# --- Optional: Reply-To header ---
# Defaults to the visitor's email address
